{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",        // Changed from "commonjs"
    "moduleResolution": "NodeNext", // Added
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist"
  },
  "include": [
    "./**/*.ts",
    "utils/gameUtils.js",
    "utils/botManager.js",
    "utils/iconUtils.js"
, "utils/validateGameSettings.js", "utils/awardUtils.js"  ]
}